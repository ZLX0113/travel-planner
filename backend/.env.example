# OpenAI 兼容 API 配置
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# 高德地图 Web 服务（在线景点/餐饮/酒店/路线/天气数据源）
# 申请地址：https://console.amap.com/dev/key/app （选「Web 服务」类型）
AMAP_KEY=

# 数据源：auto=配了高德 Key 走在线实时数据，否则回退本地 JSON；也可强制 amap / local_json
DATA_SOURCE=auto

# 航班来源：auto=在线优先，没有在线数据时用大模型生成参考航班
FLIGHT_SOURCE=auto

# 服务配置
HOST=0.0.0.0
PORT=8000